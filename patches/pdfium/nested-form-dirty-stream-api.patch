+bool CPDF_PageObjectHolder::MarkDirtyStreamForPageObject(
+    CPDF_PageObject* pPageObj) {
+  auto it = std::ranges::find_if(page_object_list_,
+                                 pdfium::MatchesUniquePtr(pPageObj));
+  if (it == std::end(page_object_list_)) {
+    return false;
+  }
+
+  const int32_t content_stream = pPageObj->GetContentStream();
+  if (content_stream < 0) {
+    return false;
+  }
+
+  dirty_streams_.insert(content_stream);
+  return true;
+}
