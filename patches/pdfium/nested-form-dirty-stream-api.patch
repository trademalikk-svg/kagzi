+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFFormObj_MarkObjectDirty(FPDF_PAGEOBJECT form_object,
+                            FPDF_PAGEOBJECT page_object) {
+  CPDF_PageObject* cform_page_object =
+      CPDFPageObjectFromFPDFPageObject(form_object);
+  if (!cform_page_object) {
+    return false;
+  }
+
+  CPDF_FormObject* form_obj = cform_page_object->AsForm();
+  if (!form_obj || !form_obj->form()) {
+    return false;
+  }
+
+  CPDF_PageObject* child_object =
+      CPDFPageObjectFromFPDFPageObject(page_object);
+  if (!child_object ||
+      !form_obj->form()->MarkDirtyStreamForPageObject(child_object)) {
+    return false;
+  }
+
+  cform_page_object->SetDirty(true);
+  return true;
+}
